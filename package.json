{
  "name": "@palmyralabs/rt-apexchart",
  "version": "0.1.0",
  "description": "ApexChart helpers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/palmyralabs/rt-apexchart.git"
  },
  "license": "MIT",
  "author": "Raja K <raja@palmyralabs.com>",
  "keywords": [
    "palmyra",
    "apexcharts",
    "react",
    "chart"
  ],
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --p ./build.tsconfig.json && vite --config vite.config.ts build",
    "compile": "tsc --p ./demo.tsconfig.json && tsc --p ./build.tsconfig.json",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "test": "vitest"
  },
  "peerDependencies": {
    "@palmyralabs/palmyra-wire": "^1.2.0",
    "@palmyralabs/ts-utils": "^0.3.0",
    "apexcharts": "^5.3.5",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.37.0",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@palmyralabs/rt-forms": "github:palmyralabs/rt-forms",
    "@palmyralabs/rt-forms-mui": "github:palmyralabs/rt-forms-mui",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "axios": "^1.12.2",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.23",
    "glob": "^11.0.3",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "moment": "^2.30.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.3",
    "serve-static": "^2.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "usehooks-ts": "^3.1.1",
    "vite": "^7.1.9",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "glob": "^11.0.3"
  }
